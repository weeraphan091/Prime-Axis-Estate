generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String
  lineId    String?  // Line ID พนักงาน (เช่น @xxx)
  isActive  Boolean  @default(true)
  createdAt String
  updatedAt String
  leads     Lead[]
  properties Property[]
}

model Lead {
  id          String   @id @default(cuid())
  propertyId  String
  propertyTitle String?
  agentId     String?
  name        String
  phone       String
  email       String
  interestType String?  // view | inquiry
  contactWhen String?
  viewWhen    String?
  message     String?
  status      String   @default("new") // new | contacted | viewing_scheduled | closed
  createdAt   String
  updatedAt   String
  agent       Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
}

model Property {
  id             String   @id @default(cuid())
  title          String
  projectName    String?  // ชื่อโปรเจ็ค/โครงการ (เช่น คอนโดชื่ออะไร หมู่บ้านชื่ออะไร)
  listingType    String   // sale | rent
  propertyType   String   // condo | house | villa | ...
  price          Int
  priceLabel     String?  // e.g. ต่อเดือน
  location       String
  mapUrl         String?
  area           Int      // ตร.ม.
  bedrooms       Int?
  bathrooms      Int?
  images         String   // JSON array of URLs
  description    String
  features       String   // JSON array
  contactName    String
  contactPhone   String
  contactEmail   String
  contactLine    String?
  contactWhatsapp String?
  isFeatured     Boolean  @default(false)
  isOwnerListing Boolean  @default(false)
  listingSource  String?  // owner_direct | from_agent
  status         String   @default("published") // draft | published | sold_rented
  agentId        String?
  // สำหรับรายการเช่า: เช่าอยู่แล้ว + ระยะสัญญา (ลูกค้าวางแผนหาห้องล่วงหน้า)
  rentOccupied   Boolean  @default(false)  // true = มีคนเช่าอยู่
  rentLeaseStart String?  // วันที่เริ่มสัญญา YYYY-MM-DD
  rentLeaseEnd   String?  // วันที่สิ้นสุดสัญญา YYYY-MM-DD
  // คอนโด/อพาร์ตเมนต์: ชั้น + เลขห้อง
  floor          Int?     // ชั้นที่อยู่
  roomNumber     String?  // เลขห้อง (เช่น 301)
  // บ้าน/วิลล่า: จำนวนชั้นของอาคาร
  floors         Int?     // 1 หรือ 2 ชั้น
  rentMinLease   Int?     // สัญญาเช่าขั้นต่ำ (เดือน) เช่น 6, 12
  quotaType      String?  // TH = โควต้าไทย, FQ = โควต้าต่างชาติ (คอนโดขาย)
  originalPrice  Int?     // ราคาเดิมก่อนลด (ถ้ามี) — ใช้คำนวณ % ลด
  viewCount      Int      @default(0)  // จำนวนครั้งที่เปิดหน้ารายละเอียด
  userId         String?  // เจ้าของที่ฝากขาย (สมาชิกที่ลงรายการ)
  titleEn        String?  // ชื่อรายการภาษาอังกฤษ
  descriptionEn  String?  // รายละเอียดภาษาอังกฤษ
  titleZh        String?  // ชื่อรายการภาษาจีน
  descriptionZh  String?  // รายละเอียดภาษาจีน
  titleRu        String?  // ชื่อรายการภาษารัสเซีย
  descriptionRu  String?  // รายละเอียดภาษารัสเซีย
  createdAt      String
  updatedAt      String
  agent          Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ContactSettings {
  id        String   @id @default("default")
  name      String
  phone     String
  email     String
  address   String
  line      String
  whatsapp  String
  wechat    String
  telegram  String
  updatedAt String
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  createdAt    String
  updatedAt    String
  properties   Property[]
}

model BlogPost {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  titleEn     String?
  titleZh     String?
  titleRu     String?
  excerpt     String
  excerptEn   String?
  excerptZh   String?
  excerptRu   String?
  content     String
  contentEn   String?
  contentZh   String?
  contentRu   String?
  coverImage  String?
  category    String   // guide | market | legal | tips
  tags        String   // JSON array
  status      String   @default("published") // draft | published
  createdAt   String
  updatedAt   String
}

model NewsletterSubscriber {
  id        String  @id @default(cuid())
  email     String  @unique
  createdAt String
}

// บัญชีผู้ใช้หลังบ้าน (แอดมิน/พนักงาน) — ล็อกอินด้วยอีเมล+รหัสผ่าน
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("staff")  // admin = ระบบหลัก สิทธิ์เต็ม | staff = พนักงาน สิทธิ์จำกัด
  isActive     Boolean  @default(true)
  createdAt    String
  updatedAt    String
}

