# URL หลักของเว็บ (SEO: canonical, sitemap, Open Graph) — ใส่โดเมนจริง เช่น https://your-site.vercel.app
# NEXT_PUBLIC_SITE_URL=https://pattayaestatehub.com

# === Supabase Storage (เก็บรูปทรัพย์) — ดู ตั้งค่า-Supabase-Storage.md ===
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ฐานข้อมูล — บน Vercel ต้องใช้ PostgreSQL (สร้างฟรีที่ supabase.com หรือ neon.tech แล้ว copy connection string มาวาง)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# === หลังบ้าน (แอดมิน) — ล็อกอินด้วยอีเมล+รหัสผ่านจากตาราง AdminUser ===
# รัน npm run db:seed เพื่อสร้างบัญชีแอดมินแรก (Kiranat56201@gmail.com)
# รหัสเริ่มต้นของแอดมินแรก = ค่า ADMIN_INITIAL_PASSWORD ด้านล่าง (หรือ Venus0979961789 ถ้าไม่ใส่)
# ADMIN_INITIAL_PASSWORD=Venus0979961789
# คีย์สำหรับ session หลังบ้าน (ถ้าไม่ใส่จะใช้ SESSION_SECRET)
# ADMIN_SESSION_SECRET=เปลี่ยนเป็นค่าลับยาวๆ

# คีย์สำหรับ session สมาชิก (สร้างค่าสุ่มยาวๆ เช่น openssl rand -base64 32)
SESSION_SECRET=เปลี่ยนเป็นค่าลับยาวๆ

# === การแจ้งเตือน (เวลาลูกค้ากด "สนใจทรัพย์นี้" แล้วส่งฟอร์ม) ===
# ระบบจะลองส่งตามลำดับ: Telegram → Line Messaging API → Line Notify
#
# --- แนะนำ: Telegram (ตั้งค่าง่าย ไม่ต้องมี Line OA ใน Developers) ---
# 1. สร้างบอท: เปิดแชทกับ @BotFather ใน Telegram → ส่ง /newbot → ได้ BOT_TOKEN
# 2. หา Chat ID: ส่งข้อความใดๆ ให้บอทของคุณ แล้วเปิดลิงก์นี้ (แทน YOUR_BOT_TOKEN):
#    https://api.telegram.org/botYOUR_BOT_TOKEN/getUpdates
#    ในผลลัพธ์ดู "chat":{"id": 123456789} → ใช้เลข id นั้นเป็น TELEGRAM_CHAT_ID
# 3. ใส่ใน .env:
# TELEGRAM_BOT_TOKEN=123456:ABCdefGHI...
# TELEGRAM_CHAT_ID=123456789
#
# --- (ทางเลือก) Line Messaging API ---
# LINE_CHANNEL_ACCESS_TOKEN=xxxxxxxxxxxx
# LINE_AGENT_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# --- (ทางเลือก) Line Notify — ยุติบริการ 31 มี.ค. 2568 ---
# LINE_NOTIFY_TOKEN=xxxxxxxxxxxx

# === อัตราแลกเปลี่ยน (แสดงราคาคู่ ฿ กับ USD/CNY/RUB ตามภาษาที่เลือก) ===
# 1 THB = 1/NEXT_PUBLIC_RATE_USD USD (เช่น 36 = 1 ฿ ≈ 0.028 USD)
# NEXT_PUBLIC_RATE_USD=36
# NEXT_PUBLIC_RATE_CNY=5
# NEXT_PUBLIC_RATE_RUB=0.35
