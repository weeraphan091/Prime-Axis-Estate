# รหัสผ่านเข้าหลังบ้าน (admin) — เปลี่ยนก่อน deploy จริง
ADMIN_PASSWORD=admin123

# คีย์สำหรับ session สมาชิก (สร้างค่าสุ่มยาวๆ เช่น openssl rand -base64 32)
SESSION_SECRET=เปลี่ยนเป็นค่าลับยาวๆ

# === การแจ้งเตือน (เวลาลูกค้ากด "สนใจทรัพย์นี้" แล้วส่งฟอร์ม) ===
# ระบบจะลองส่งตามลำดับ: Telegram → Line Messaging API → Line Notify
#
# --- แนะนำ: Telegram (ตั้งค่าง่าย ไม่ต้องมี Line OA ใน Developers) ---
# 1. สร้างบอท: เปิดแชทกับ @BotFather ใน Telegram → ส่ง /newbot → ได้ BOT_TOKEN
# 2. หา Chat ID: ส่งข้อความใดๆ ให้บอทของคุณ แล้วเปิดลิงก์นี้ (แทน YOUR_BOT_TOKEN):
#    https://api.telegram.org/botYOUR_BOT_TOKEN/getUpdates
#    ในผลลัพธ์ดู "chat":{"id": 123456789} → ใช้เลข id นั้นเป็น TELEGRAM_CHAT_ID
# 3. ใส่ใน .env:
# TELEGRAM_BOT_TOKEN=123456:ABCdefGHI...
# TELEGRAM_CHAT_ID=123456789
#
# --- (ทางเลือก) Line Messaging API ---
# LINE_CHANNEL_ACCESS_TOKEN=xxxxxxxxxxxx
# LINE_AGENT_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# --- (ทางเลือก) Line Notify — ยุติบริการ 31 มี.ค. 2568 ---
# LINE_NOTIFY_TOKEN=xxxxxxxxxxxx
